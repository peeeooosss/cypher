generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANIZER
  ARTIST
  JUDGE
  ADMIN
}

enum PaymentStatus {
  NONE
  PENDING
  VERIFIED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventType {
  UNDERGROUND_BATTLE
  DANCE_COMPETITION
  MUSIC_COMPETITION
  WORKSHOP
}

enum Skill {
  DANCER
  CHOREOGRAPHER
  PERFORMER
  DJ
  MC
  GUITARIST
  DRUMMER
  RAPPER
  VOCALIST
  PRODUCER
  BEATBOXER
  PHOTOGRAPHER
  VISUAL_ARTIST
}

enum GigStatus {
  OPEN
  IN_PROGRESS
  FILLED
  CLOSED
}

enum GigApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WITHDRAWN
}

enum MatchStatus {
  PENDING
  LIVE
  LOCKED
  COMPLETE
}

enum RoundType {
  CYPHER
  QUALIFIER
  BATTLE_1V1
  BATTLE_2V2
  BATTLE_3V3
  BATTLE_4V4
  CREW_VS_CREW
  SEVEN_TO_SMOKE
  FINAL
}

enum CategoryFormat {
  SOLO
  DUO
  GROUP
  BATTLE_1V1
  BATTLE_2V2
  BATTLE_3V3
  CREW_VS_CREW
}

enum RegistrationMemberRole {
  CAPTAIN
  MEMBER
}

enum RegistrationMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  username        String?           @unique
  passwordHash    String?
  role            UserRole          @default(ARTIST)
  avatarUrl       String?
  upiId           String?
  style           String?
  crew            String?
  city            String?
  country         String?
  experience      String?
  socialHandle    String?
  referral        String?
  skills          Skill[]           @default([])
  organizedEvents Event[]           @relation("EventOrganizer")
  registrations   Registration[]
  teamMemberships RegistrationMember[] @relation("RegistrationMemberUser")
  feedbackTemplates FeedbackTemplate[]
  gigs            Gig[]             @relation("OrganizerGigs")
  gigApplications GigApplication[]  @relation("ArtistGigApplications")
  achievements    ArtistAchievement[]
  gigWorkEnabledAt DateTime?
  gigWorkExpiresAt DateTime?
  gigWorkPaymentStatus PaymentStatus @default(NONE)
  gigWorkPaymentMethod String?
  gigWorkPaymentSentAt DateTime?
  gigWorkPaymentVerifiedBy String?
  gigWorkPaidAt DateTime?
  isSuspended    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Event {
  id             String       @id @default(cuid())
  organizerId    String
  title          String
  slug           String       @unique
  description    String?
  eventType      EventType?
  posterUrl      String?
  venue          String?
  city           String?
  state          String?
  startsAt       DateTime
  status         EventStatus  @default(DRAFT)
  categoryCount  Int?
  flatFee        Int?
  flatFeePaid    Boolean      @default(false)
  flatFeePaidAt  DateTime?
  flatFeePaymentStatus PaymentStatus @default(NONE)
  flatFeePaymentMethod String?
  flatFeePaymentSentAt DateTime?
  flatFeePaymentVerifiedBy String?
  commissionDue  Int?
  commissionPaid Boolean      @default(false)
  commissionPaidAt DateTime?
  commissionPaymentStatus PaymentStatus @default(NONE)
  commissionPaymentMethod String?
  commissionPaymentSentAt DateTime?
  commissionPaymentVerifiedBy String?
  organizer      User         @relation("EventOrganizer", fields: [organizerId], references: [id])
  categories     Category[]
  judgeSlots     JudgeSlot[]
  matches        BattleMatch[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizerId])
  @@index([startsAt])
}

model Category {
  id             String         @id @default(cuid())
  eventId        String
  name           String
  format         CategoryFormat?
  minMembers     Int              @default(1)
  maxMembers     Int              @default(1)
  maxCompetitors Int?
  entryFee       Int?           @default(0)
  entryCurrency  String         @default("INR")
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rounds         RoundFormat[]
  registrations  Registration[]
  registrationMembers RegistrationMember[]
  matches        BattleMatch[]
  judgeSlots     JudgeSlot[]
  prizePool      PrizePool?
  currentPhaseOrder Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
}

model RoundFormat {
  id            String    @id @default(cuid())
  categoryId    String
  order         Int
  type          RoundType
  label         String?
  roundCount    Int       @default(1)
  roundDuration Int?
  advanceCount  Int?
  phaseStatus    String?   @default("PENDING")
  timeLimitMs    Int       @default(60000)
  dancerScores   DancerScore[]
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([categoryId, order])
}

model Registration {
  id           String             @id @default(cuid())
  userId       String
  categoryId   String
  format       CategoryFormat?
  teamName     String?
  rosterLockedAt DateTime?
  status       RegistrationStatus @default(PENDING)
  entryFee     Int?
  entryCurrency String?
  paid         Boolean            @default(false)
  paidAt       DateTime?
  paidClaimedAt DateTime?
  seed         Int?
  style        String?
  crew         String?
  city         String?
  country      String?
  experience   String?
  socialHandle String?
  referral     String?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  members      RegistrationMember[]
  matchesAsA   BattleMatch[]      @relation("CompetitorA")
  matchesAsB   BattleMatch[]      @relation("CompetitorB")
  matchesWon   BattleMatch[]      @relation("MatchWinner")
  dancerScores DancerScore[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([userId, categoryId])
  @@index([categoryId, status])
}

model RegistrationMember {
  id               String                    @id @default(cuid())
  registrationId   String
  categoryId       String
  userId           String
  role             RegistrationMemberRole    @default(MEMBER)
  status           RegistrationMemberStatus @default(PENDING)
  invitedAt        DateTime                  @default(now())
  acceptedAt       DateTime?
  registration     Registration              @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  category         Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user             User                      @relation("RegistrationMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([registrationId, userId])
  @@unique([categoryId, userId])
  @@index([userId, status])
}

model BattleMatch {
  id              String        @id @default(cuid())
  eventId         String
  categoryId      String
  round           Int
  position        Int
  status          MatchStatus   @default(PENDING)
  competitorAId   String?
  competitorBId   String?
  scoreA          Int           @default(0)
  scoreB          Int           @default(0)
  winnerId        String?
  nextMatchId     String?
  teamLabelA      String?
  teamLabelB      String?
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  competitorA     Registration? @relation("CompetitorA", fields: [competitorAId], references: [id])
  competitorB     Registration? @relation("CompetitorB", fields: [competitorBId], references: [id])
  winner          Registration? @relation("MatchWinner", fields: [winnerId], references: [id])
  nextMatch       BattleMatch?  @relation("BracketProgression", fields: [nextMatchId], references: [id])
  previousMatches BattleMatch[] @relation("BracketProgression")
  scores          MatchScore[]
  judgeAssignments JudgeAssignment[]
  battleTimer     BattleTimer?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([categoryId, round, position])
  @@index([eventId, categoryId])
  @@index([nextMatchId])
}

model JudgeSlot {
  id         String       @id @default(cuid())
  eventId    String
  categoryId String
  code       String       @unique
  name       String?
  isActive   Boolean      @default(true)
  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scores     MatchScore[]
  dancerScores DancerScore[]
  judgeAssignments JudgeAssignment[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([categoryId, code])
}

model DancerScore {
  id             String       @id @default(cuid())
  judgeSlotId    String
  registrationId String
  roundFormatId  String
  score          Int
  feedback       String?
  judgeSlot      JudgeSlot    @relation(fields: [judgeSlotId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  roundFormat    RoundFormat  @relation(fields: [roundFormatId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([judgeSlotId, registrationId, roundFormatId])
  @@index([registrationId])
  @@index([roundFormatId])
}

model MatchScore {
  id           String      @id @default(cuid())
  matchId     String
  judgeSlotId String
  scoreA      Int
  scoreB      Int
  winnerCorner String?
  feedback    String?
  match       BattleMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  judgeSlot   JudgeSlot   @relation(fields: [judgeSlotId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([matchId, judgeSlotId])
  @@index([judgeSlotId])
}

model FeedbackTemplate {
  id          String   @id @default(cuid())
  organizerId String
  text        String
  scoreLabel  String?
  minScore    Int      @default(0)
  maxScore    Int      @default(10)
  category    String?
  organizer   User     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PrizePool {
  id           String   @id @default(cuid())
  categoryId   String   @unique
  totalAmount  Int
  currency     String   @default("USD")
  distribution Json
  isPaid       Boolean  @default(false)
  paidAt       DateTime?
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JudgeAssignment {
  id          String      @id @default(cuid())
  matchId     String
  judgeSlotId String
  panelOrder  Int
  match       BattleMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  judgeSlot   JudgeSlot   @relation(fields: [judgeSlotId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([matchId, judgeSlotId])
  @@index([matchId])
}

model BattleTimer {
  id            String      @id @default(cuid())
  matchId       String      @unique
  timeLimitMs   Int
  startedAt     DateTime?
  lockedAt      DateTime?
  warningsSent  String[]    @default([])
  match         BattleMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ScoreAuditLog {
  id           String   @id @default(cuid())
  matchId      String
  judgeSlotId  String
  oldScoreRed  Int?
  oldScoreBlue Int?
  newScoreRed  Int
  newScoreBlue Int
  changedBy    String
  reason       String?
  createdAt    DateTime @default(now())
  @@index([matchId])
}

model Gig {
  id             String             @id @default(cuid())
  organizerId    String
  title          String
  description    String
  skillsRequired Skill[]            @default([])
  location       String?
  budget         Int?
  currency       String             @default("INR")
  startsAt       DateTime?
  status         GigStatus          @default(OPEN)
  feePaid        Boolean            @default(false)
  feePaidAt      DateTime?
  organizer      User               @relation("OrganizerGigs", fields: [organizerId], references: [id], onDelete: Cascade)
  applications   GigApplication[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizerId])
  @@index([status])
}

model GigApplication {
  id           String               @id @default(cuid())
  gigId        String
  artistId     String
  message      String?
  status       GigApplicationStatus @default(PENDING)
  gig          Gig                  @relation(fields: [gigId], references: [id], onDelete: Cascade)
  artist       User                 @relation("ArtistGigApplications", fields: [artistId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([gigId, artistId])
  @@index([artistId])
}

model ArtistAchievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  competition String?
  placement   String?
  year        Int?
  prize       Int?
  currency    String   @default("INR")
  note        String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
